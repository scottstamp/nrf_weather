[Unit]
Description=wxd e-paper weather display daemon
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=wxd
Group=wxd
# Only needed where the BlueZ D-Bus policy restricts access to this group (Ubuntu allows everyone).
SupplementaryGroups=bluetooth
# Adjust to your install location.
ExecStart=/opt/wxd/venv/bin/wxd --config /etc/wxd/config.toml run
Restart=always
RestartSec=5
CacheDirectory=wxd
Environment=XDG_CACHE_HOME=/var/cache
NoNewPrivileges=true
ProtectSystem=strict
# read-only (not true) so an editable install (pip install -e) from a repo in /home still works.
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
